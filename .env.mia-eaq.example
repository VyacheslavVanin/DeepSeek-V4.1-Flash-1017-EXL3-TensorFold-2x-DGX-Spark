# Template for variant A: the Mia-AiLab EAQ checkpoint through the Python TensorFold engine.
# Copy it once on a clean checkout (it is tracked; the real file is gitignored):
#
#     cp .env.mia-eaq.example .env.mia-eaq
#     # or: scripts/bootstrap-mia-eaq.sh   (copies it and pulls the engine image)
#
# Then edit WORKER_SSH / HEAD_IP / WORKER_IP for your pair if they differ. start.sh and stop.sh use
# .env.mia-eaq by default; ENV_FILE=.env selects the LibertAI recipe instead.
#
# The engine image is public; the model is not in it. MODEL_VIEW is built from the Hugging Face cache by
# scripts/link_mia_view.sh and copied to the worker by scripts/sync_view.sh.

VARIANT=mia-eaq

# --- The two nodes on the ConnectX-7 link (QSFP cable between the Sparks) ---
HEAD_IP=192.168.100.10            # head's address on the CX7 link (rank 0, rendezvous host)
WORKER_IP=192.168.100.11          # worker's address on the CX7 link (rank 1)
WORKER_SSH=spark1@192.168.100.11  # how the head reaches the worker with ssh (user@host or an ssh alias)

# --- RoCE and NCCL (see docs/NETWORK.md; `ibdev2netdev` and `ip -br addr` show your names) ---
RDMA_DEVICES=rocep1s0f1,roceP2p1s0f1   # TensorFold's own RDMA gathers (both CX7 ports)
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1         # the netdev that holds HEAD_IP / WORKER_IP
GID_INDEX=3                            # RoCE v2 IPv4 GID; after a link flap the index can move: set -1 (auto) then
# The RDMA proxy thread busy-polls its completion queue (one full core even when idle). Pin it to a Cortex-A725
# efficiency core (0-4 or 10-14); -1 leaves it unpinned. The engine and CUDA threads stay free on the X925 cores.
TF_RDMA_CPU=0

# --- Paths (the same paths on both nodes) ---
MODEL_VIEW=$HOME/models/deepseek-v41-1017-mia-eaq-2.9bpw   # built by scripts/link_mia_view.sh
DOWNLOAD_DIR=$MODEL_VIEW.src                           # unused in variant A (no download.sh)
CACHE_DIR=$HOME/tfv41-cache-mia-eaq                      # rank caches and compiled kernels, separate from the LibertAI cache
PREFLIGHT=0                                              # skip host_tuning/MTU checks; see setup_mtu.sh
MIN_WEIGHT_SHARDS=39                                     # the Mia EAQ checkpoint has 39 shards (default check is 43)

# --- Engine image (docker/build.sh builds it on the head and copies it to the worker) ---
TF_REPO=https://github.com/Elevatormusic/TensorFold.git
TF_COMMIT=07aa02585f64                 # PRs 1-4 and 6 of the fork, with their review fixes; see docs/WHAT-I-CHANGED.md
# The public image we built for this variant. Rebuild it with docker/build.sh, then docker push.
IMAGE=vaninvv/tensorfold-dsv41:mia-eaq-07aa02585f64   # docker.io; digest sha256:84dafddbb83df7eabbe74494f35bde01b430df94e926f5101b4ed5c2ce02a990
# Build base. The public Mia image has the same NGC PyTorch 26.07 base and can be pulled on a clean machine.
# For a clean NGC build: docker login nvcr.io, then set BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3.
BASE_IMAGE=ghcr.io/miaai-lab/deepseek-v4.1-flash-1017-2x-dgx-sparks-tensorfold:latest

# --- Serving ---
BIND_HOST=0.0.0.0            # LAN: anyone who reaches port 8888 can use it (set API_KEY_FILE to require a key)
PORT=8888
SERVED_NAME=DeepSeek-V4.1-Flash-1017
SERVED_ALIAS=                  # optional second model id (for example the id your router already uses)
API_KEY_FILE=                  # optional: a file with one API key per line (mounted read-only)
CONTEXT=1048576                # 1M tokens: the model's full window
MAX_TOKENS=130000              # default reply budget (thinking + answer); a request's max_tokens wins
PARALLEL=4                     # concurrent requests on the lane (--parallel)
MTP_DRAFTS=5                   # DSpark draft depth (speculative decoding); 4 measured slower (runs/2026-10-17/17_*)
SPILL_GIB=64                   # kept prompts also go to CACHE_DIR/tf-ds-spill (max GiB): a prompt survives a restart; 0 = off
MEM_FLOOR_GIB=1.5              # after the warm-up the engine grows only while the node keeps this much memory free (GiB)
CGROUP_PARENT=                 # empty: no host_tuning.sh slice (variant A skips host tuning)
TEMPERATURE=1.0                # DeepSeek's recommended sampling for V4.1
TOP_P=1.0
THINKING=0                     # 1: thinking on for requests that do not say (longer replies, more tokens)
REASONING_EFFORT=              # effort when thinking is on and a request sets none: low, medium, high or xhigh; empty = high
VISION=1                       # 1: accept image input (--vision)
RESTART_POLICY=no              # docker restart policy; see docs/OPERATIONS.md before you change it

# After a reboot the direct-link MTU is back at 1500; run ./setup_mtu.sh before ./start.sh.
# The model/Engram are not downloaded by this template: put them in the Hugging Face cache, then run
# scripts/link_mia_view.sh and scripts/sync_view.sh (see their headers).
